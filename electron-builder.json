{
  "appId": "com.byrudan.oua",
  "productName": "OOOInterface易升",
  "directories": {
    "output": "build2"
  },
  "files": [
    "main/**/*",
    "renderer/**/*",
    "package.json",
    "!storage/**/*",
    "!temp/**/*",
    "!build/**/*",
    "!build2/**/*",
    "!scripts/**/*",
    "!test-api.js",
    "!README.md",
    "!PROJECT.md"
  ],
  "copyright": "Copyright © 2026 ByRUDAN",
  "extraResources": [
    {
      "from": "tools/hotkey-helper.exe",
      "to": "hotkey-helper.exe"
    },
    {
      "from": "renderer/assets/icons/icon.ico",
      "to": "icon.ico"
    }
  ],
  "win": {
    "icon": "renderer/assets/icons/icon.ico",
    "executableName": "oua",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "OOOInterface易升", 
    "deleteAppDataOnUninstall": false,
    "include": "installer/installer.nsh"
  },
  "portable": {
    "artifactName": "oua-portable-${version}.${ext}"
  },
  "linux": {
    "icon": "build/icons",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Utility",
    "maintainer": "ByRUDAN",
    "vendor": "ByRUDAN",
    "synopsis": "OOOInterface 易升",
    "description": "OOOInterface易升"
  },
  "deb": {
    "packageName": "ooointerface-update-assistant",
    "priority": "optional",
    "packageCategory": "utils"
  },
  "mac": {
    "icon": "renderer/assets/icons/logo.png",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.utilities",
    "type": "distribution",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null
  },
  "dmg": {
    "title": "${productName} ${version}",
    "writeUpdateInfo": false
  }
}
