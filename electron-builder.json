{
  "appId": "com.byrudan.oua",
  "productName": "OOOInterface易升",
  "directories": {
    "output": "build2"
  },
  "copyright": "Copyright © 2025 ByRUDAN",
  "win": {
    "icon": "renderer/assets/icons/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "OOOInterface易升", 
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "icon": "build/icons",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Utility",
    "maintainer": "ByRUDAN",
    "vendor": "ByRUDAN",
    "synopsis": "OOOInterface Update Assistant",
    "description": "OOOInterface易升 - OOOInterface 更新助手"
  },
  "deb": {
    "packageName": "ooointerface-update-assistant",
    "priority": "optional",
    "packageCategory": "utils"
  },
  "mac": {
    "icon": "renderer/assets/icons/logo.png",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.utilities",
    "type": "distribution",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null
  },
  "dmg": {
    "title": "${productName} ${version}",
    "writeUpdateInfo": false
  }
}
